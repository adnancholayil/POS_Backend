# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pos-saas

# JWT Secret Configuration
JWT_SECRET=super_secret_jwt_sign_key_12345
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_sign_key_67890
JWT_REFRESH_EXPIRE=7d

# SMTP Configuration (Email Delivery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@shopmanager.com

# Cloudinary Configuration (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client Configuration
CLIENT_URL=http://localhost:3000
